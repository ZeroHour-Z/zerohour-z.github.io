---
// Local replacement for astro-pure's Footer: full-width black block, big type.
import config from '@/site-config'

const footerConf = config.footer
const labels: Record<string, string> = {
  github: 'GitHub',
  netease: 'Netease Music',
  bilibili: 'Bilibili',
  x: 'X',
  email: 'Mail'
}
const social = Object.entries(footerConf.social ?? {}).map(([key, value]) => {
  const url = typeof value === 'string' ? value : (value as { url: string }).url
  return { label: labels[key] ?? key, url }
})
social.push({ label: 'RSS', url: '/rss.xml' })

const links = footerConf.links ?? []
const infoLinks = links.filter(({ pos }) => pos !== 2)
const policyLinks = links.filter(({ pos }) => pos === 2)
---

<footer class='site-footer mt-16 w-full'>
  <div class='mx-auto w-full max-w-[70rem] px-4 pb-8 pt-14 sm:px-7 lg:px-10'>
    <a href='/' class='footer-title block font-bold'>{config.author}</a>

    <div class='mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3'>
      <div>
        <p class='footer-label'>Pages</p>
        <ul class='footer-list'>
          {
            (config.header.menu ?? []).map((item) => (
              <li>
                <a href={item.link}>{item.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class='footer-label'>Elsewhere</p>
        <ul class='footer-list'>
          {
            social.map(({ label, url }) => (
              <li>
                <a href={url} target={url.startsWith('/') ? undefined : '_blank'}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class='footer-label'>Site</p>
        <ul class='footer-list'>
          {
            [...infoLinks, ...policyLinks].map(({ title, link }) => (
              <li>
                <a href={link} target={link.startsWith('/') ? undefined : '_blank'}>
                  {title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class='footer-bottom mt-14 flex flex-col gap-y-2 pt-5 text-sm sm:flex-row sm:justify-between'>
      <span>{footerConf.year} {config.author}</span>
      {
        footerConf.credits && (
          <span>
            Built with{' '}
            <a href='https://github.com/withastro/astro' target='_blank'>
              Astro
            </a>{' '}
            &{' '}
            <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>
              Pure
            </a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: hsl(0 0% 5%);
    color: hsl(0 0% 100%);
  }
  :global(.dark) .site-footer {
    background-color: hsl(0 0% 6%);
    border-top: 1px solid hsl(var(--border));
  }
  .footer-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .footer-label {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.55);
  }
  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .site-footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s;
  }
  .site-footer a:hover {
    color: inherit;
    text-decoration-color: hsl(var(--block-yellow));
  }
  .footer-bottom {
    border-top: 1px solid hsl(0 0% 100% / 0.2);
    color: hsl(0 0% 100% / 0.6);
  }
</style>
