---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import Footer from '@/components/basic/Footer.astro'
import Header from '@/components/basic/Header.astro'
import BaseHead from '@/components/BaseHead.astro'
import BackgroundDecorator from '@/components/home/BackgroundDecorator.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/app.css'
import '@/assets/styles/inner.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  /** Skip the centered content container so the page can use full-bleed sections. */
  wide?: boolean
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor,
  wide = false,
  ...props
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body
    class='flex min-h-[100dvh] flex-col text-foreground'
    style='background: transparent; isolation: isolate;'
    {...props}
  >
    {/* 全局背景 */}
    <BackgroundDecorator type='none' transition:persist />

    <Header transition:name='header' transition:animate='none' />
    <div
      class:list={[
        'w-full flex-1',
        !wide && 'mx-auto max-w-[var(--site-max)] px-4 pt-10 sm:px-7 lg:px-10'
      ]}
      style='position: relative; z-index: 1;'
    >
      <slot />
    </div>
    <Footer transition:name='footer' transition:animate='none' />

    {/* Scroll reveal observer */}
    <script>
      const zeroHourLayoutState = globalThis as typeof globalThis & {
        __zeroHourScrollRevealBound?: boolean
      }

      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible')
                observer.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        )

        document.querySelectorAll('.scroll-reveal').forEach((el) => observer.observe(el))
      }

      initScrollReveal()
      if (!zeroHourLayoutState.__zeroHourScrollRevealBound) {
        document.addEventListener('astro:after-swap', initScrollReveal)
        zeroHourLayoutState.__zeroHourScrollRevealBound = true
      }
    </script>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>
  </body>
</html>
