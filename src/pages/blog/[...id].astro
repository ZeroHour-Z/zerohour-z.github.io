---
import { render, type CollectionEntry } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PostLayout from '@/layouts/BlogPost.astro'
import { getNoteUrl, isRegularBlogPost } from '@/utils/course-notes'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection())
  const regularPosts = posts.filter(isRegularBlogPost)
  // Course notes used to live at /blog/<course>/<chapter>; they now have their own
  // docs collection, so generate redirect pages for the old URLs.
  const docs = await getBlogCollection('docs')
  return [
    ...posts.map((post) => ({
      params: { id: post.id },
      props: { post, posts: regularPosts }
    })),
    ...docs.map((doc) => ({
      params: { id: doc.id },
      props: { redirectTo: getNoteUrl(doc) }
    }))
  ]
}

type Props =
  | { post: CollectionEntry<'blog'>; posts: CollectionEntry<'blog'>[]; redirectTo?: undefined }
  | { redirectTo: string; post?: undefined; posts?: undefined }

const { post, posts, redirectTo } = Astro.props

if (redirectTo !== undefined) {
  return Astro.redirect(encodeURI(redirectTo), 301)
}

const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter} back='/blog'>
  <Content />
</PostLayout>
