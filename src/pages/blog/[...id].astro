---
import { render, type CollectionEntry } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PostLayout from '@/layouts/BlogPost.astro'
import { getNoteUrl, isCourseNote, isRegularBlogPost } from '@/utils/course-notes'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection())
  const regularPosts = posts.filter(isRegularBlogPost)
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts: regularPosts }
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
}

const { post, posts } = Astro.props

// Course notes moved to /notes/<course>/<chapter>; keep old /blog/... links working.
if (isCourseNote(post)) {
  return Astro.redirect(encodeURI(getNoteUrl(post)), 301)
}

const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter} back='/blog'>
  <Content />
</PostLayout>
