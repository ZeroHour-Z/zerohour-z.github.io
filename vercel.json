{
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "framework": "astro",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
